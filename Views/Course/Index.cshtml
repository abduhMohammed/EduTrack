@model List<Course>
@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
<a asp-controller="Course" asp-action="Add" class="btn btn-success">New Course</a>
<table class="table table_border table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Degree</th>
            <th>Department</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Degree</td>
                <td>@item.Department.Name</td>
            </tr>
        }
    </tbody>
</table>