@model Course
@{
    ViewData["Title"] = "SavaData";
    //SelectList deptOptions = new SelectList(ViewBag["DeptList"], "id", "Name");
}

<h1>SavaData</h1>
<form method="Post" asp-action="SaveAdd" asp-controller="Course">
    <div asp-validation-summary="All"></div>
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Degree"></label>
        <input asp-for="Degree" class="form form-control" />
        <span asp-validation-for="Degree" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="DepartmentID"></label>
        @* <input asp-for="DepartmentID" class="form form-control" /> *@
        <select asp-for="DepartmentID" class="form form-control">
            <option value="0">--Select Department--</option>
            @foreach (var dept in ViewBag.DeptList)
            {
                <option value="@dept.id">@dept.Name</option>
            }
        </select>
        <span asp-validation-for="DepartmentID" class="text-danger"></span>
    </div>
    <input type="submit" value="Create" class="btn btn-success" />
</form>
<a asp-controller="Course" asp-action="New">Go to List</a>